# --- Claude (photo analysis) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Where reports go ---
# "email" (default), "open311" (stub until Birmingham publishes an API),
# or "demo" (nothing is sent; returns a fake DEMO-… reference)
REPORT_SENDER=email
# The inbox that receives reports. Use YOUR OWN address while testing.
# Birmingham does not publish a 311 intake email (see DECISIONS.md D-009).
CITY_311_EMAIL=you@example.com
# Resend (https://resend.com) API key + a verified sender address
RESEND_API_KEY=re_...
REPORT_FROM_EMAIL=House Monsters <reports@your-verified-domain.com>

# Optional Open311 GeoReport v2 endpoint (not available for Birmingham today)
OPEN311_BASE_URL=
OPEN311_API_KEY=
OPEN311_SERVICE_CODE=

# Shown on the confirmation screen so users can also file/track on the city's own portal
NEXT_PUBLIC_CITY_311_PORTAL_URL=https://birminghamal.gov/311

# Demo extras (sample-monsters button on an empty collection)
NEXT_PUBLIC_DEMO=
